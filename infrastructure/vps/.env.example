COMPOSE_PROJECT_NAME=rp-gant
TZ=Europe/Moscow
LOG_LEVEL=info

POSTGRES_USER=rp_gant
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
POSTGRES_DB=rp_gant_user
USER_DB=rp_gant_user
PROJECT_DB=rp_gant_project
NOTIFICATION_DB=rp_gant_notification
AUDIT_DB=rp_gant_audit

DATABASE_URL_USER=postgres://rp_gant:CHANGE_ME_RANDOM_HEX@postgres:5432/rp_gant_user
DATABASE_URL_PROJECT=postgres://rp_gant:CHANGE_ME_RANDOM_HEX@postgres:5432/rp_gant_project
DATABASE_URL_NOTIFICATION=postgres://rp_gant:CHANGE_ME_RANDOM_HEX@postgres:5432/rp_gant_notification
DATABASE_URL_AUDIT=postgres://rp_gant:CHANGE_ME_RANDOM_HEX@postgres:5432/rp_gant_audit

KAFKA_TOPIC=rp_gant.events
SYNC_TOKEN_SECRET=CHANGE_ME_RANDOM_HEX
RATE_LIMIT_MAX=300

PUBLIC_APP_URL=https://app.rp-gant.ru
CORS_ORIGINS=https://app.rp-gant.ru

SMTP_HOST=smtp.jino.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@app.rp-gant.ru
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="RP Gant <no-reply@rp-gant.ru>"

TELEGRAM_BOT_TOKEN=

DEV_AUTO_VERIFY=false
DEV_ADMIN_EMAIL=adm@rp-gant.ru
DEV_ADMIN_PASSWORD=CHANGE_ME
DEV_ADMIN_LAST_NAME=Миронов
DEV_ADMIN_FIRST_NAME=Юрий
DEV_ADMIN_MIDDLE_NAME=Владимирович
