COMPOSE_PROJECT_NAME=rp-gant
TZ=Europe/Moscow
LOG_LEVEL=debug

POSTGRES_USER=rp_gant
POSTGRES_PASSWORD=rp_gant_dev
POSTGRES_DB=rp_gant_user

DATABASE_URL_USER=postgres://rp_gant:rp_gant_dev@postgres:5432/rp_gant_user
DATABASE_URL_PROJECT=postgres://rp_gant:rp_gant_dev@postgres:5432/rp_gant_project
DATABASE_URL_NOTIFICATION=postgres://rp_gant:rp_gant_dev@postgres:5432/rp_gant_notification
DATABASE_URL_AUDIT=postgres://rp_gant:rp_gant_dev@postgres:5432/rp_gant_audit

REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=rp_gant.events
KAFKA_CONSUMER_GROUP_NOTIFICATION=notification
KAFKA_CONSUMER_GROUP_AUDIT=audit
KAFKA_CONSUMER_GROUP_SYNC=sync

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=noreply@rp-gant.local
MAILPIT_UI_PORT=8025

TELEGRAM_API_BASE=http://telegram-mock:8080
TELEGRAM_BOT_TOKEN=dev-bot-token
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
TELEGRAM_BOT_USERNAME=rp_gant_dev_bot

CORS_ORIGINS=https://app.rp-gant.localhost
SESSION_COOKIE_NAME=__Host-session
REMEMBER_COOKIE_NAME=__Host-remember
CSRF_COOKIE_NAME=__Host-csrf

DEV_ADMIN_EMAIL=admin@rp-gant.local
DEV_ADMIN_PASSWORD=ChangeMeDevOnly!
DEV_ADMIN_LAST_NAME=Администратор
DEV_ADMIN_FIRST_NAME=Системный
DEV_ADMIN_MIDDLE_NAME=
DEV_AUTO_VERIFY=true

API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
GRPC_PORT=50051
PROJECT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUDIT_SERVICE_PORT=8084
SYNC_SERVICE_PORT=8085
FRONTEND_PORT=3000
