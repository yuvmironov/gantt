COMPOSE_PROJECT_NAME=smart-oati
TZ=Europe/Moscow
LOG_LEVEL=debug

POSTGRES_USER=smart_oati
POSTGRES_PASSWORD=smart_oati_dev
POSTGRES_DB=smart_oati_user

DATABASE_URL_USER=postgres://smart_oati:smart_oati_dev@postgres:5432/smart_oati_user
DATABASE_URL_PROJECT=postgres://smart_oati:smart_oati_dev@postgres:5432/smart_oati_project
DATABASE_URL_NOTIFICATION=postgres://smart_oati:smart_oati_dev@postgres:5432/smart_oati_notification
DATABASE_URL_AUDIT=postgres://smart_oati:smart_oati_dev@postgres:5432/smart_oati_audit

REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=smartoati.events
KAFKA_CONSUMER_GROUP_NOTIFICATION=notification
KAFKA_CONSUMER_GROUP_AUDIT=audit
KAFKA_CONSUMER_GROUP_SYNC=sync

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@smart-oati.local
MAILPIT_UI_PORT=8025

TELEGRAM_API_BASE=http://telegram-mock:8080
TELEGRAM_BOT_TOKEN=dev-bot-token
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
TELEGRAM_BOT_USERNAME=smart_oati_dev_bot

NUXT_PUBLIC_APP_NAME=SMART OATI
NUXT_PUBLIC_API_BASE=https://api.localhost/api/v1
NUXT_PUBLIC_SYNC_WS=wss://sync.localhost/ws
NUXT_PUBLIC_NOTIFICATION_WS=wss://notify.localhost/ws/notifications

CORS_ORIGINS=https://app.localhost
SESSION_COOKIE_NAME=__Host-session
REMEMBER_COOKIE_NAME=__Host-remember
CSRF_COOKIE_NAME=__Host-csrf

DEV_ADMIN_EMAIL=admin@smart-oati.local
DEV_ADMIN_PASSWORD=ChangeMeDevOnly!
DEV_ADMIN_LAST_NAME=Администратор
DEV_ADMIN_FIRST_NAME=Системный
DEV_ADMIN_MIDDLE_NAME=
DEV_AUTO_VERIFY=true

API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
GRPC_PORT=50051
PROJECT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUDIT_SERVICE_PORT=8084
SYNC_SERVICE_PORT=8085
FRONTEND_PORT=3000
