{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-oati.local/schemas/event-envelope.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "sourceService",
    "payload",
    "actorRoles"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceService": {
      "type": "string",
      "enum": [
        "user",
        "project",
        "notification",
        "audit"
      ]
    },
    "actorUserId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actorRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "diagramId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "entityType": {
      "type": [
        "string",
        "null"
      ]
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
