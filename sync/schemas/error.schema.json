{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-gant.local/schemas/ws-error.json",
  "title": "WsError",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "code"
  ],
  "properties": {
    "type": {
      "const": "error"
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "recoverable": {
      "type": "boolean"
    }
  }
}
