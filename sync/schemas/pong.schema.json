{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp-gant.local/schemas/ws-pong.json",
  "title": "WsPong",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "at"
  ],
  "properties": {
    "type": {
      "const": "pong"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
