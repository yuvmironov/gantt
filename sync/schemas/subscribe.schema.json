{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-oati.local/schemas/ws-subscribe.json",
  "title": "WsSubscribe",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "requestId", "diagramId", "lastRevision"],
  "properties": {
    "type": { "const": "subscribe" },
    "requestId": { "type": "string", "format": "uuid" },
    "diagramId": { "type": "string", "format": "uuid" },
    "lastRevision": { "type": "integer", "minimum": 0 }
  }
}
