{
  "name": "smart-oati",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:contract",
    "test:unit": "vitest run",
    "test:contract": "node tools/check-contracts.mjs",
    "start:api-gateway": "node apps/api-gateway/src/index.js",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "vitest": "^5.0.5"
  }
}
